# Copy this file to typesetting.env and adjust as needed.
# Every value here can also be overridden on the command line; see
# `./distrobox-typesetting --help`. CLI flags take precedence over this file.

# Base container image (any Alpine/Debian/Ubuntu/Fedora/RHEL-family image).
BASE_IMAGE=alpine:latest

# TeX Live release: a year (e.g. 2025, 2026) or "latest".
TEXLIVE_RELEASE=latest

# TeX Live scheme: minimal, basic, small, medium, full, infraonly, ...
TEXLIVE_SCHEME=full

# Extra TeX Live packages to install on top of the scheme above (space- or
# comma-separated). Most useful with a non-full scheme.
TEXLIVE_PACKAGES=""

# LilyPond version to install.
LILYPOND_VERSION=2.26.0

# Git ref (branch, tag, or commit) of lbssousa/gregorio to build Gregorio from.
GREGORIO_REF=playground-2026-08-27

# Name of the distrobox container to create.
CONTAINER_NAME=typesetting

# Container engine used to build the image: auto, podman, or docker.
# "auto" prefers podman and falls back to docker.
ENGINE=auto
