# Copy this file to typesetting.env and adjust as needed.
# Every value here can also be overridden on the command line; see
# `./distrobox-typesetting --help`. CLI flags take precedence over this file.

# Base container image (any Alpine/Debian/Ubuntu/Fedora/RHEL-family image).
BASE_IMAGE=alpine:latest

# TeX Live release: a year (e.g. 2025, 2026) or "latest".
TEXLIVE_RELEASE=latest

# TeX Live scheme: minimal, basic, small, medium, full, infraonly, ...
# Currently defaulted to "minimal" (+ TEXLIVE_PACKAGES below) instead of
# "full" while iterating on the build; see the matching comment in
# Containerfile.
TEXLIVE_SCHEME=minimal

# Extra TeX Live packages to install on top of the scheme above (space- or
# comma-separated). Most useful with a non-full scheme.
TEXLIVE_PACKAGES="babel-latin,babel-portuges,booktabs,csquotes,ebgaramond,enumitem,epstopdf-pkg,float,fontspec,geometry,hyperref,hyphen-latin,hyphen-portuguese,l3packages,latex-bin,latexindent,latexmk,libertine,listings,luacolor,luamplib,luatex85,luatexbase,memoir,metapost,metre,microtype,musixtex,musixtex-fonts,paracol,pgf,quoting,relsize,stackengine,standalone,subfiles,texcount,textcase,tikzmark,tools,varwidth,xcolor,xetex,xkeyval,xpatch,xstring"

# TeX Live mirror base URL (the "/CTAN/systems/texlive/tlnet" path is
# appended automatically). Defaults to the mirror used by
# AISCGre-BR/Eugene-Cardine-Primeiro-Ano-de-Semiologia-Gregoriana.
TEXLIVE_MIRROR=https://linorg.usp.br

# LilyPond version to install.
LILYPOND_VERSION=2.26.0

# Git ref (branch, tag, or commit) of lbssousa/gregorio to build Gregorio from.
GREGORIO_REF=playground-2026-08-27

# Locale (LANG) of the container, e.g. pt_BR.UTF-8. "auto" uses the host's
# (LC_ALL, else LANG, else /etc/locale.conf), falling back to C.UTF-8.
LOCALE=auto

# Name of the distrobox container to create.
CONTAINER_NAME=typesetting

# Container engine used to build the image: auto, podman, or docker.
# "auto" prefers podman and falls back to docker.
ENGINE=auto
